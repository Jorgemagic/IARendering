<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IARendering.Avalonia.Controls.LoadingSpinner"
             Width="56"
             Height="56">
    <Grid Width="56" Height="56">
        <Ellipse Width="48"
                 Height="48"
                 Stroke="{DynamicResource SpinnerTrackBrush}"
                 StrokeThickness="4" />
        <Path x:Name="SpinnerArc"
              Width="48"
              Height="48"
              Data="M 24,4 A 20,20 0 1 1 43,24"
              Stretch="Fill"
              Stroke="{DynamicResource SpinnerAccentBrush}"
              StrokeThickness="4"
              StrokeLineCap="Round"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform Angle="0" />
            </Path.RenderTransform>
        </Path>
    </Grid>
</UserControl>
