<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IARendering.Avalonia.Controls.ZoomPanImageViewer">
    <Border x:Name="Viewport"
            Background="Transparent"
            ClipToBounds="True">
        <Canvas x:Name="CanvasRoot">
            <Image x:Name="ImageHost"
                   Stretch="Fill" />
        </Canvas>
    </Border>
</UserControl>
