<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IARendering.Avalonia"
        xmlns:controls="clr-namespace:IARendering.Avalonia.Controls"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
        xmlns:viewModels="clr-namespace:IARendering.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="IARendering.Avalonia.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="IA Rendering"
        Width="1280"
        Height="966"
        MaxHeight="1080"
        MinWidth="1100"
        MinHeight="966"
        Background="#202020">
    <Grid Margin="6"
          RowDefinitions="420,52,420,28">
        <Border Grid.Row="0"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Background="#2B2B2B"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="ViewportDragOver"
                DragDrop.Drop="ViewportDrop">
            <Grid>
                <local:EvergineControl x:Name="RenderControl"
                                       DisplayTag="DefaultDisplay"
                                       IsVisible="{Binding ShowViewportSurface}" />

                <Border Background="#66000000"
                        IsHitTestVisible="False"
                        IsVisible="{Binding ShowViewportSpinner}" />

                <Grid IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding ShowViewportPlaceholder}">
                        <TextBlock FontSize="22"
                                   Foreground="White"
                                   Text="3D Viewport" />
                        <TextBlock FontSize="18"
                                   Foreground="White"
                                   Text="Drag and drop new models" />
                        <TextBlock FontSize="16"
                                   Foreground="White"
                                   Text="{Binding SupportedExtensionsText}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14"
                                IsVisible="{Binding ShowViewportSpinner}">
                        <controls:LoadingSpinner />
                        <TextBlock FontSize="16"
                                   Foreground="White"
                                   Text="Loading model..." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#3A3A3A"
                BorderThickness="1,0,1,0"
                Background="#242424">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <primitives:ToggleButton Margin="12,8,0,8"
                                         Padding="14,8"
                                         VerticalAlignment="Center"
                                         IsChecked="{Binding IsAiSettingsPanelOpen}"
                                         Content="AI Settings" />

                <TextBlock Margin="16,0,16,0"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#F0F0F0"
                           Text="{Binding StatusMessage}" />

                <ComboBox Grid.Column="2"
                          Width="90"
                          Margin="0,8,8,8"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AiRenderRuntimeOptions}"
                          SelectedItem="{Binding SelectedAiRenderRuntime, Mode=TwoWay}" />

                <Button Grid.Column="3"
                        Margin="12,8"
                        Padding="18,8"
                        Click="GenerateAiRender_Click"
                        IsEnabled="{Binding CanGenerateRender}"
                        Content="Generate IA Render" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Background="#242424">
            <Grid>
                <controls:ImageCompareViewer LeftSource="{Binding ViewportCaptureImage}"
                                             RightSource="{Binding ResultImage}"
                                             IsVisible="{Binding ShowResultImage}" />

                <Border Width="320"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Padding="14"
                        Background="#2A2A2A"
                        BorderBrush="#3A3A3A"
                        BorderThickness="0,0,1,0"
                        IsVisible="{Binding IsAiSettingsPanelOpen}">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#F0F0F0"
                                   Text="AI Render Settings" />
                        <TextBlock FontSize="13"
                                   Foreground="#D0D0D0"
                                   Text="Prompt" />
                        <TextBox MinHeight="150"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Text="{Binding AiRenderPrompt, Mode=TwoWay}" />
                        <TextBlock FontSize="13"
                                   Foreground="#D0D0D0"
                                   Text="cfg-scale" />
                        <TextBox Text="{Binding AiRenderCfgScaleText, Mode=TwoWay}" />
                        <TextBlock FontSize="13"
                                   Foreground="#D0D0D0"
                                   Text="steps" />
                        <TextBox Text="{Binding AiRenderStepsText, Mode=TwoWay}" />
                        <TextBlock FontSize="12"
                                   Foreground="#E6A23C"
                                   Text="{Binding AiRenderSettingsErrorMessage}"
                                   IsVisible="{Binding HasAiRenderSettingsError}" />
                    </StackPanel>
                </Border>

                <Grid IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding ShowRenderPlaceholder}">
                        <TextBlock FontSize="22"
                                   Foreground="#F0F0F0"
                                   Text="IA Render" />
                        <TextBlock FontSize="16"
                                   Foreground="#D0D0D0"
                                   Text="The generated result will appear here." />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14"
                                IsVisible="{Binding ShowRenderSpinner}">
                        <controls:LoadingSpinner />
                        <TextBlock FontSize="16"
                                   Foreground="#F0F0F0"
                                   Text="Generating IA render..." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#3A3A3A"
                BorderThickness="1,0,1,1"
                Background="#242424">
            <TextBlock Margin="12,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontFamily="Consolas"
                       Foreground="#F0F0F0"
                       Text="{Binding LastRenderDurationText}" />
        </Border>
    </Grid>
</Window>
