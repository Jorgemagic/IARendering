<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IARendering.Avalonia"
        xmlns:controls="clr-namespace:IARendering.Avalonia.Controls"
        xmlns:viewModels="clr-namespace:IARendering.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="IARendering.Avalonia.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="IA Rendering"
        Width="1280"
        Height="860"
        MinWidth="960"
        MinHeight="720"
        Background="#202020">
    <Grid Margin="12"
          RowDefinitions="3.8*,0.7*,3*,0.35*">
        <Border Grid.Row="0"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Background="#2B2B2B"
                DragDrop.AllowDrop="True"
                DragDrop.DragOver="ViewportDragOver"
                DragDrop.Drop="ViewportDrop">
            <Grid>
                <local:EvergineControl x:Name="RenderControl"
                                       DisplayTag="DefaultDisplay"
                                       IsVisible="{Binding ShowViewportSurface}" />

                <Border Background="#66000000"
                        IsHitTestVisible="False"
                        IsVisible="{Binding ShowViewportSpinner}" />

                <Grid IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding ShowViewportPlaceholder}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="22"
                                   Foreground="White"
                                   Text="3D Viewport" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="18"
                                   Foreground="White"
                                   Text="Drag and drop new models" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="White"
                                   Text="{Binding SupportedExtensionsText}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14"
                                IsVisible="{Binding ShowViewportSpinner}">
                        <controls:LoadingSpinner HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="White"
                                   Text="Loading model..." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#3A3A3A"
                BorderThickness="1,0,1,0"
                Background="#242424">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Margin="16,0,16,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#F0F0F0"
                           Text="{Binding StatusMessage}" />

                <Button Grid.Column="1"
                        Margin="12,8"
                        Padding="18,8"
                        Click="GenerateAiRender_Click"
                        IsEnabled="{Binding CanGenerateRender}"
                        Content="Generate IA Render" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#3A3A3A"
                BorderThickness="1"
                Background="#242424">
            <Grid>
                <controls:ZoomPanImageViewer Margin="12"
                                             Source="{Binding ResultImage}"
                                             IsVisible="{Binding ShowResultImage}" />

                <Grid IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding ShowRenderPlaceholder}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="22"
                                   Foreground="#F0F0F0"
                                   Text="IA Render" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="#D0D0D0"
                                   Text="The generated result will appear here." />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="14"
                                IsVisible="{Binding ShowRenderSpinner}">
                        <controls:LoadingSpinner HorizontalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   Foreground="#F0F0F0"
                                   Text="Generating IA render..." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#3A3A3A"
                BorderThickness="1,0,1,1"
                Background="#242424">
            <TextBlock Margin="12,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="#F0F0F0"
                       Text="{Binding LastRenderDurationText}" />
        </Border>
    </Grid>
</Window>
